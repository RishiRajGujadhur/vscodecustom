{
	"name": "structural-typescript",
	"displayName": "%displayName%",
	"description": "%description%",
	"version": "0.2.0",
	"publisher": "vscode",
	"license": "MIT",
	"engines": {
		"vscode": "^1.100.0"
	},
	"main": "./out/extension.js",
	"activationEvents": [
		"onLanguage:typescript",
		"onLanguage:typescriptreact",
		"onLanguage:javascript",
		"onLanguage:javascriptreact"
	],
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": false
		},
		"virtualWorkspaces": false
	},
	"dependencies": {
		"typescript": "5.9.3"
	},
	"devDependencies": {
		"@types/node": "24.x"
	},
	"scripts": {
		"check": "tsc -p . --noEmit",
		"test": "tsc -p . && tsc -p test && node --test test/*.test.mts"
	},
	"contributes": {
		"views": {
			"explorer": [
				{
					"id": "structural.reactStructure",
					"name": "%reactStructure%"
				},
				{
					"id": "structural.analysis",
					"name": "%analysis%"
				}
			]
		},
		"commands": [
			{
				"command": "structural.typeDependencies",
				"title": "%typeDependencies%",
				"category": "%category%"
			},
			{
				"command": "structural.typeDependents",
				"title": "%typeDependents%",
				"category": "%category%"
			},
			{
				"command": "structural.flowFrom",
				"title": "%flowFrom%",
				"category": "%category%"
			},
			{
				"command": "structural.flowTo",
				"title": "%flowTo%",
				"category": "%category%"
			},
			{
				"command": "structural.unused",
				"title": "%unused%",
				"category": "%category%"
			},
			{
				"command": "structural.parameterObject",
				"title": "%parameterObject%",
				"category": "%category%"
			},
			{
				"command": "structural.inlineParameterObject",
				"title": "%inlineParameterObject%",
				"category": "%category%"
			},
			{
				"command": "structural.pullMemberUp",
				"title": "%pullMemberUp%",
				"category": "%category%"
			},
			{
				"command": "structural.pushMemberDown",
				"title": "%pushMemberDown%",
				"category": "%category%"
			},
			{
				"command": "structural.extractComponent",
				"title": "%extractComponent%",
				"category": "%category%"
			},
			{
				"command": "structural.safeRename",
				"title": "%safeRename%",
				"category": "%category%"
			},
			{
				"title": "%functionFlow%",
				"command": "structural.functionFlow",
				"category": "%category%"
			},
			{
				"title": "%valueOrigins%",
				"command": "structural.valueOrigins",
				"category": "%category%"
			},
			{
				"command": "structural.safeDelete",
				"title": "%safeDelete%",
				"category": "%category%"
			},
			{
				"command": "structural.safeDeleteFile",
				"title": "%safeDeleteFile%",
				"category": "%category%"
			},
			{
				"command": "structural.changeSignature",
				"title": "%changeSignature%",
				"category": "%category%"
			},
			{
				"command": "structural.moveModuleMembers",
				"title": "%moveModuleMembers%",
				"category": "%category%"
			},
			{
				"command": "structural.findDeadCode",
				"title": "%findDeadCode%",
				"category": "%category%"
			},
			{
				"command": "structural.advancedNullability",
				"title": "%advancedNullability%",
				"category": "%category%"
			},
			{
				"command": "structural.testImpact",
				"title": "%testImpact%",
				"category": "%category%"
			},
			{
				"command": "structural.openTools",
				"title": "%openTools%",
				"category": "%category%"
			},
			{
				"command": "structural.showIntentions",
				"title": "%showIntentions%",
				"category": "%category%"
			},
			{
				"command": "structural.clearAnalysisResults",
				"title": "%clearAnalysisResults%",
				"category": "%category%"
			}
		],
		"submenus": [
			{
				"label": "%category%",
				"id": "structural.tools"
			}
		],
		"menus": {
			"structural.tools": [
				{
					"command": "structural.typeDependencies",
					"group": "1_analysis@0"
				},
				{
					"command": "structural.typeDependents",
					"group": "1_analysis@1"
				},
				{
					"command": "structural.flowFrom",
					"group": "1_analysis@2"
				},
				{
					"command": "structural.flowTo",
					"group": "1_analysis@3"
				},
				{
					"command": "structural.unused",
					"group": "1_analysis@4"
				},
				{
					"command": "structural.parameterObject",
					"group": "2_refactor@5"
				},
				{
					"command": "structural.inlineParameterObject",
					"group": "2_refactor@6"
				},
				{
					"command": "structural.pullMemberUp",
					"group": "2_refactor@7"
				},
				{
					"command": "structural.pushMemberDown",
					"group": "2_refactor@8"
				},
				{
					"command": "structural.extractComponent",
					"group": "2_refactor@9"
				},
				{
					"command": "structural.safeRename",
					"group": "2_refactor@10"
				},
				{
					"command": "structural.functionFlow",
					"group": "1_analysis@11"
				},
				{
					"command": "structural.valueOrigins",
					"group": "1_analysis@12"
				},
				{
					"command": "structural.safeDelete",
					"group": "2_refactor@13"
				},
				{
					"command": "structural.safeDeleteFile",
					"group": "2_refactor@14"
				},
				{
					"command": "structural.changeSignature",
					"group": "2_refactor@15"
				},
				{
					"command": "structural.moveModuleMembers",
					"group": "2_refactor@16"
				},
				{
					"command": "structural.findDeadCode",
					"group": "1_analysis@17"
				},
				{
					"command": "structural.advancedNullability",
					"group": "1_analysis@18"
				},
				{
					"command": "structural.testImpact",
					"group": "1_analysis@19"
				},
				{
					"command": "structural.openTools",
					"group": "0_tools@0"
				},
				{
					"command": "structural.showIntentions",
					"group": "0_tools@1"
				},
				{
					"command": "structural.clearAnalysisResults",
					"group": "3_results"
				}
			],
			"editor/context": [
				{
					"group": "1_modification@6",
					"submenu": "structural.tools",
					"when": "resourceScheme == file && editorLangId =~ /^(typescript|typescriptreact|javascript|javascriptreact)$/"
				}
			]
		}
	}
}
