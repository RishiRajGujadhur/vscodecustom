{
	"name": "structural-typescript",
	"displayName": "%displayName%",
	"description": "%description%",
	"version": "0.1.0",
	"publisher": "vscode",
	"license": "MIT",
	"engines": {
		"vscode": "^1.100.0"
	},
	"main": "./out/extension.js",
	"activationEvents": [
		"onLanguage:typescript",
		"onLanguage:typescriptreact",
		"onLanguage:javascript",
		"onLanguage:javascriptreact"
	],
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": false
		},
		"virtualWorkspaces": false
	},
	"dependencies": {
		"typescript": "5.9.3"
	},
	"devDependencies": {
		"@types/node": "24.x"
	},
	"scripts": {
		"check": "tsc -p . --noEmit",
		"test": "tsc -p . && tsc -p test && node --test test/*.test.mts"
	},
	"contributes": {
		"views": {
			"explorer": [
				{
					"id": "structural.reactStructure",
					"name": "%reactStructure%"
				},
				{
					"id": "structural.analysis",
					"name": "%analysis%"
				}
			]
		},
		"commands": [
			{
				"command": "structural.typeDependencies",
				"title": "%typeDependencies%",
				"category": "%category%"
			},
			{
				"command": "structural.typeDependents",
				"title": "%typeDependents%",
				"category": "%category%"
			},
			{
				"command": "structural.flowFrom",
				"title": "%flowFrom%",
				"category": "%category%"
			},
			{
				"command": "structural.flowTo",
				"title": "%flowTo%",
				"category": "%category%"
			},
			{
				"command": "structural.unused",
				"title": "%unused%",
				"category": "%category%"
			},
			{
				"command": "structural.parameterObject",
				"title": "%parameterObject%",
				"category": "%category%"
			},
			{
				"command": "structural.inlineParameterObject",
				"title": "%inlineParameterObject%",
				"category": "%category%"
			},
			{
				"command": "structural.pullMemberUp",
				"title": "%pullMemberUp%",
				"category": "%category%"
			},
			{
				"command": "structural.pushMemberDown",
				"title": "%pushMemberDown%",
				"category": "%category%"
			},
			{
				"command": "structural.extractComponent",
				"title": "%extractComponent%",
				"category": "%category%"
			},
			{
				"command": "structural.safeRename",
				"title": "%safeRename%",
				"category": "%category%"
			},
			{
				"title": "%functionFlow%",
				"command": "structural.functionFlow",
				"category": "%category%"
			},
			{
				"title": "%valueOrigins%",
				"command": "structural.valueOrigins",
				"category": "%category%"
			}
		],
		"submenus": [
			{
				"label": "%category%",
				"id": "structural.tools"
			}
		],
		"menus": {
			"structural.tools": [
				{
					"command": "structural.typeDependencies"
				},
				{
					"command": "structural.typeDependents"
				},
				{
					"command": "structural.flowFrom"
				},
				{
					"command": "structural.flowTo"
				},
				{
					"command": "structural.unused"
				},
				{
					"command": "structural.parameterObject"
				},
				{
					"command": "structural.inlineParameterObject"
				},
				{
					"command": "structural.pullMemberUp"
				},
				{
					"command": "structural.pushMemberDown"
				},
				{
					"command": "structural.extractComponent"
				},
				{
					"command": "structural.safeRename"
				},
				{
					"command": "structural.functionFlow"
				},
				{
					"command": "structural.valueOrigins"
				}
			],
			"editor/context": [
				{
					"group": "1_modification@6",
					"submenu": "structural.tools",
					"when": "resourceScheme == file && editorLangId =~ /^(typescript|typescriptreact|javascript|javascriptreact)$/"
				}
			]
		}
	}
}
